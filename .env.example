# ==============================================================================
# AfroRemote — Environment Variables Template (.env.example)
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit a real '.env' file containing actual keys or tokens to Git.
# - In production or cloud deployments (Cloud Run, Docker, CI/CD), inject these
#   variables securely via Secret Manager or environment settings.
# - Copy this template to '.env' for local development: `cp .env.example .env`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side AI & Intelligence (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY:
# Required for resume multimodal parsing, semantic vector embeddings,
# tailored cover letters, and WAT candidate guide generation.
# AI Studio automatically injects this from the Secrets panel.
# Scope: Strictly Server-Side. Never expose to client bundles or browsers.
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 2. Server & Application Routing
# ------------------------------------------------------------------------------
# PORT:
# The local and container port the Node/Express server binds to.
# Default: 3000 (Required for AI Studio dev server).
PORT=3000

# NODE_ENV:
# Application runtime mode: 'development', 'production', or 'test'.
# Default: 'development'
NODE_ENV="development"

# APP_URL:
# Public canonical URL where this application is hosted.
# Used for self-referential links, OAuth origins, and email digest footers.
# Automatically injected by AI Studio / Cloud Run at runtime.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. Client-Side Variables (Vite Prefix Convention)
# ------------------------------------------------------------------------------
# Any client-facing variable MUST be prefixed with 'VITE_' to be recognized by Vite.
# Note: Google Workspace OAuth & Firebase Auth are configured client-side via
# firebase-applet-config.json and runtime access tokens are kept in memory only.
# VITE_APP_NAME="AfroRemote"
